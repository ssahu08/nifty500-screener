# ---------------------------------------------------------------------------
# N500 Stock Screener - example environment file
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="N500 Stock Screener"
ENV=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
TIMEZONE=Asia/Kolkata
# Numeric PIN protecting the dashboard API on a public deployment (Render).
# Empty = auth disabled (local development). Set it in production; the value
# is an HMAC key for session cookies, so keep it private.
DASHBOARD_PIN=

# --- Storage ---------------------------------------------------------------
# SQLite file used for run history (rolling retention, see RETENTION_DAYS).
DATABASE_PATH=data/screener.db
# Number of days of run history to keep (rolling window, FR-11).
RETENTION_DAYS=14

# --- FYERS (NSE market data) ----------------------------------------------
# Create an app at https://myapi.fyers.in and copy the credentials below.
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://127.0.0.1:8000/callback
# FYERS login id (the account id used to sign in, e.g. FAK12345). Needed for
# the automated login flow along with the PIN and TOTP secret.
FYERS_FY_ID=
FYERS_PIN=
# Base32 TOTP key from enabling "External 2FA (TOTP)" on the FYERS account.
FYERS_TOTP_SECRET=
# Optional: paste a pre-generated access token. When empty, tokens are obtained
# automatically via the PIN + TOTP login and renewed each day. Tokens expire daily.
FYERS_ACCESS_TOKEN=
# Optional: 15-day refresh token used as a bootstrap when data/fyers_tokens.json
# is missing (fresh deploy on an ephemeral disk). Rotated refresh tokens are
# persisted to that file; if both are gone, the PIN + TOTP login re-authenticates.
FYERS_REFRESH_TOKEN=

# --- Telegram (alerts) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=true
# Off by default (FR-14): do NOT notify when a run has zero matches.
TELEGRAM_NOTIFY_EMPTY=false

# --- Global indices (Market Overview) -------------------------------------
# Free source for non-NSE indices. Decided in the data-layer phase.
GLOBAL_INDEX_PROVIDER=yfinance

# --- Market data sources ---------------------------------------------------
# Live/primary source used while the NSE session is open (fyers).
MARKET_PROVIDER=fyers
# Source used outside session hours and as a fallback when a live call fails
# (yfinance, groww, or empty to always use the primary source).
OFFHOURS_MARKET_PROVIDER=yfinance

# --- Groww Trade API -------------------------------------------------------
# Access token for the Groww Trade API (Bearer header). Needed only when
# OFFHOURS_MARKET_PROVIDER=groww; historical data is a paid Groww add-on.
GROWW_API_KEY=
# Base URL of the Groww Trade API.
GROWW_API_BASE_URL=https://api.groww.in
